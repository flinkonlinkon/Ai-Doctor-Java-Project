<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="page-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dermavisionai.controller.UploadController">
    <VBox spacing="20" styleClass="page">
        <padding>
            <Insets top="28" right="32" bottom="28" left="32"/>
        </padding>
        <Label text="Skin Analysis Result" styleClass="page-title"/>
        <HBox spacing="22">
            <VBox fx:id="dropZone" spacing="14" minWidth="380" alignment="CENTER" styleClass="upload-zone">
                <Label text="Uploaded Image" styleClass="card-title"/>
                <ImageView fx:id="previewImage" fitWidth="250" fitHeight="280" preserveRatio="true" styleClass="preview-image">
                    <image>
                        <Image url="@../images/sample-face.png"/>
                    </image>
                </ImageView>
                <Label fx:id="imageNameLabel" text="Drop a JPG or PNG image here" styleClass="muted-label"/>
                <Button text="Browse Image" onAction="#browseImage" styleClass="secondary-button"/>
                <Button text="Analyze Now" onAction="#analyzeImage" styleClass="primary-button"/>
            </VBox>
            <VBox spacing="14" HBox.hgrow="ALWAYS" styleClass="card">
                <padding>
                    <Insets top="22" right="22" bottom="22" left="22"/>
                </padding>
                <Label text="Overall Skin Score" styleClass="section-title"/>
                <HBox spacing="28">
                    <VBox spacing="8">
                        <Label text="Skin Score" styleClass="muted-label"/>
                        <Label fx:id="scoreLabel" text="--/100" styleClass="metric-label"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Confidence" styleClass="muted-label"/>
                        <Label fx:id="confidenceLabel" text="--" styleClass="metric-label"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Severity" styleClass="muted-label"/>
                        <Label fx:id="severityLabel" text="--" styleClass="metric-label"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Skin Type" styleClass="muted-label"/>
                        <Label fx:id="skinTypeLabel" text="--" styleClass="metric-label"/>
                    </VBox>
                </HBox>
                <ProgressBar fx:id="scoreProgress" prefWidth="420" progress="0"/>
                <FlowPane fx:id="issuesPane" hgap="12" vgap="12"/>
            </VBox>
        </HBox>
        <VBox spacing="14" styleClass="card">
            <padding>
                <Insets top="22" right="22" bottom="22" left="22"/>
            </padding>
            <Label text="Personalized Recommendations" styleClass="section-title"/>
            <VBox fx:id="recommendationsBox" spacing="10"/>
        </VBox>
    </VBox>
</ScrollPane>
